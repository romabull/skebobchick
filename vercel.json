{
  "version": 2,
  "functions": {
    "server.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/admin",
      "dest": "server.js"
    },
    {
      "src": "/admin.js",
      "dest": "server.js"
    },
    {
      "src": "/admin.css",
      "dest": "server.js"
    },
    {
      "src": "/script.js",
      "dest": "server.js"
    },
    {
      "src": "/style.css",
      "dest": "server.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}